generator client {
  provider = "prisma-client-js"
  //output   = "../src/prisma"
}

datasource db {
  provider = "mysql"
  // url      = env("DATABASE_URL")
}

model usuario {
  id        Int    @id @default(autoincrement())
  email     String @unique(map: "email") @db.VarChar(100)
  password  String @db.VarChar(255)
  nombre    String @db.VarChar(50)
  apellido  String @db.VarChar(50)
  direccion String @db.VarChar(150)

  pedidos   pedido[]
  productos producto[]
  tokens_recuperacion token_recuperacion[] 
}

model token_recuperacion {
  id         Int      @id @default(autoincrement())
  usuario_id Int
  token      String   @unique @db.VarChar(255)
  creado_en  DateTime @default(now())
  expira_en  DateTime
  usado      Boolean  @default(false)

  usuario    usuario  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@index([usuario_id], map: "fk_token_usuario")
}

model pedido {
  id                  Int      @id @default(autoincrement())
  usuario_id          Int
  estado              EstadoPedido @default(CARRITO)
  fecha_creacion      DateTime @default(now())
  fecha_actualizacion DateTime @updatedAt
  precio_total        Decimal  @db.Decimal(10, 2)

  usuario usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  productos producto_pedido[]

  @@index([usuario_id], map: "fk_pedido_usuario")
}

model producto_pedido {
  id              Int     @id @default(autoincrement())
  producto_id     Int
  pedido_id       Int
  precio_unitario Decimal @db.Decimal(10, 2)
  cantidad        Int
  subtotal        Decimal @db.Decimal(10, 2)

  producto producto @relation(fields: [producto_id], references: [id], onDelete: Cascade)
  pedido   pedido   @relation(fields: [pedido_id], references: [id])

  @@index([producto_id], map: "fk_producto_pedido_producto")
  @@index([pedido_id], map: "fk_producto_pedido_pedido")
}

enum EstadoPedido {
  CARRITO
  PENDIENTE
  PAGO
  CANCELADO
}

model producto {
  id            Int     @id @default(autoincrement())
  nombre        String  @db.VarChar(100)
  descripcion   String  @db.Text
  clasificacion String  @db.VarChar(50)
  precio        Decimal @db.Decimal(10, 2)
  usuario_id    Int

  usuario  usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  pedidos  producto_pedido[]
  imagenes producto_imagen[]

  @@index([usuario_id], map: "fk_producto_usuario")
}

model producto_imagen {
  id          Int    @id @default(autoincrement())
  producto_id Int
  datos       String @db.LongText
  tipo_mime   String @db.VarChar(100)
  orden       Int    @default(0)

  producto producto @relation(fields: [producto_id], references: [id], onDelete: Cascade)

  @@index([producto_id], map: "fk_producto_imagen_producto")
}
